#!/usr/bin/env bash
set -euo pipefail

# Run biome check --write only when staged files live under pablo-web/
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

staged=()
while IFS= read -r -d '' path; do
	staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- pablo-web/)

if [[ ${#staged[@]} -eq 0 ]]; then
	exit 0
fi

rel_paths=()
for path in "${staged[@]}"; do
	rel_paths+=("${path#pablo-web/}")
done

set +e
output="$(
	cd pablo-web
	bunx biome check --write -- "${rel_paths[@]}" 2>&1
)"
status=$?
set -e

if [[ $status -ne 0 ]]; then
	# Staged paths may all be outside biome.json includes (e.g. AGENTS.md)
	if [[ "$output" == *"No files were processed"* ]]; then
		exit 0
	fi
	printf '%s\n' "$output"
	exit "$status"
fi

printf '%s\n' "$output"
git add -- "${staged[@]}"
