{
  "name": "pablo-web",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "api:fetch-openapi": "mkdir -p openapi && curl -fsS http://localhost:8000/openapi/v1.json -o openapi/openapi.json",
    "api:generate": "orval --config orval.config.ts",
    "prebuild": "bun run generate-routes",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-router": "1.170.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "1.168.23",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "orval": "^8.24.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.2",
    "vite": "^8.0.0"
  }
}
