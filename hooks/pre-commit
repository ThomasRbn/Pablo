#!/usr/bin/env bash
set -euo pipefail

# Format staged frontend (biome) and backend (dotnet format) files, then re-stage.
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# --- Frontend: biome check --write when staged files live under pablo-web/ ---
web_staged=()
while IFS= read -r -d '' path; do
	web_staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- pablo-web/)

if [[ ${#web_staged[@]} -gt 0 ]]; then
	rel_paths=()
	for path in "${web_staged[@]}"; do
		rel_paths+=("${path#pablo-web/}")
	done

	set +e
	output="$(
		cd pablo-web
		bunx biome check --write -- "${rel_paths[@]}" 2>&1
	)"
	status=$?
	set -e

	if [[ $status -ne 0 ]]; then
		# Staged paths may all be outside biome.json includes (e.g. AGENTS.md)
		if [[ "$output" != *"No files were processed"* ]]; then
			printf '%s\n' "$output"
			exit "$status"
		fi
	else
		printf '%s\n' "$output"
		git add -- "${web_staged[@]}"
	fi
fi

# --- Backend: dotnet format when staged C# files live under pablo/ ---
backend_staged=()
while IFS= read -r -d '' path; do
	backend_staged+=("$path")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- pablo/ | grep -z '\.cs$' || true)

if [[ ${#backend_staged[@]} -gt 0 ]]; then
	dotnet format pablo/pablo.slnx --include "${backend_staged[@]}"
	git add -- "${backend_staged[@]}"
fi
